# ───────────────────────────────────────────────
#  .gitignore — files Git should NEVER track
# ───────────────────────────────────────────────

# 🔐 Secrets & environment files
.env
.env.local
.env.*.local
*.env
secrets/
*.key
*.pem
*.p12
id_rsa
id_rsa.pub
credentials.json

# 📦 Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/
vendor/

# 💻 IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-*
.project
.classpath

# 🖥️ OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# 📝 Logs & temp files
*.log
logs/
*.tmp
*.temp
tmp/

# 🏗️ Build outputs
dist/
build/
out/
target/
*.exe
*.out
*.class
*.jar

# 🧪 Test / coverage
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
